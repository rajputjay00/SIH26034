# LegalMetriX Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.

# Application Information
APP_NAME=LegalMetriX Compliance & Inspection System
ENVIRONMENT=development
DEBUG=True

# Cryptographic & Security Settings
# In production, replace with a 64+ character random string
SECRET_KEY=DEV_ONLY_SECURE_SECRET_KEY_MUST_BE_REPLACED_IN_PROD_123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
DATABASE_URL=sqlite:///./legalmetrix.db

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Report & QR Code Verification Base URL
REPORT_VERIFICATION_BASE_URL=http://localhost:3000/verify

# Storage Base Paths
STORAGE_EVIDENCE_PATH=storage/evidence
STORAGE_DERIVED_PATH=storage/derived
STORAGE_REPORTS_PATH=storage/reports
