# ==============================================================================
# NIRIKSHAN / SIH26034 — FastAPI Backend Environment Configuration Template
# ==============================================================================

# Application Branding & Mode
APP_NAME="NIRIKSHAN - Legal Metrology Compliance & Inspection System"
ENVIRONMENT="development"  # Use "production" in deployed environment
DEBUG=True                 # Must be False in production

# Security & Authentication (JWT)
# In production, replace with a strong 64+ character random hex string:
SECRET_KEY="CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite WAL mode by default; or PostgreSQL URI)
DATABASE_URL="sqlite:///./legalmetrix.db"
# Example PostgreSQL: DATABASE_URL="postgresql://user:password@host:5432/nirikshan_db"

# Production CORS: Comma-separated list of allowed frontend origins (NO WILDCARDS in production)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app"
FRONTEND_URL="http://localhost:3000"

# Public Report Verification Portal URL embedded into generated QR codes
REPORT_VERIFICATION_BASE_URL="http://localhost:3000/verify"

# Filesystem Storage Paths (Mount persistent volume disk in production container)
STORAGE_EVIDENCE_PATH="storage/evidence"
STORAGE_DERIVED_PATH="storage/derived"
STORAGE_REPORTS_PATH="storage/reports"

# Server Port (PaaS platforms like Render/Railway automatically inject PORT)
PORT=8000
