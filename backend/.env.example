# LegalMetriX Backend Configuration

APP_NAME="LegalMetriX Backend API"
ENVIRONMENT="development"
DEBUG=True

# Security
SECRET_KEY="CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (SQLite with WAL mode for Phase 1 MVP)
DATABASE_URL="sqlite:///./legalmetrix.db"

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
